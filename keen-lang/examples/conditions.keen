let age = 17

if age >= 18 {
    print("Adult")
} else {
    print("Minor")
}

fn grade(score) {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else {
        return "F"
    }
}

print(grade(95), grade(85), grade(72), grade(10))
print(age > 10 and age < 20, not (age == 17), age == 17 or false)
