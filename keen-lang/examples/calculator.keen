// A small calculator built from functions and conditions
fn calculate(a, op, b) {
    if op == "+" {
        return a + b
    } else if op == "-" {
        return a - b
    } else if op == "*" {
        return a * b
    } else if op == "/" {
        if b == 0 {
            return "cannot divide by zero"
        }
        return a / b
    } else if op == "%" {
        return a % b
    } else {
        return "unknown operator"
    }
}

print("12 + 5 =", calculate(12, "+", 5))
print("12 - 5 =", calculate(12, "-", 5))
print("12 * 5 =", calculate(12, "*", 5))
print("12 / 5 =", calculate(12, "/", 5))
print("12 % 5 =", calculate(12, "%", 5))
print("12 / 0 =", calculate(12, "/", 0))
print("12 ^ 5 =", calculate(12, "^", 5))
